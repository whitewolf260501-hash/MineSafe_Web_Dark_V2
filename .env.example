# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# CONFIGURACIÓN DE MINESAFE IA ANALYSIS BACKEND (FastAPI)
# ============================================================================
# URL del backend de análisis estadístico en Python / FastAPI (v0.1.1).
# El proxy Vite (/api/ai) reenvía las peticiones a esta dirección de forma segura.
MINESAFE_AI_URL="http://127.0.0.1:8000"

# Clave privada para autenticar contra POST /v1/analyze.
# NUNCA usar prefijo VITE_* para esta clave. El proxy del servidor inyecta la cabecera
# 'Authorization: Bearer <KEY>' en el servidor, manteniéndola oculta del navegador.
MINESAFE_AI_API_KEY="generar-clave-aleatoria-privada-en-produccion"

# Opcional: URL personalizada para la API de IA desde el cliente web
# Por defecto se utiliza '/api/ai' (el proxy seguro local).
# VITE_AI_API_URL="/api/ai"

# ============================================================================
# CONFIGURACIÓN DE FIREBASE REALTIME DATABASE (IoT Telemetry)
# ============================================================================
VITE_FIREBASE_RTDB_URL="https://minefase-fc5f5-default-rtdb.firebaseio.com/"

