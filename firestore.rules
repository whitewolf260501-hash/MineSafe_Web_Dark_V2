rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // IoT Sensor devices and live measurements
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Safety and contingency alerts
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    // Equipment rental contracts and payments
    match /rentals/{rentalId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
